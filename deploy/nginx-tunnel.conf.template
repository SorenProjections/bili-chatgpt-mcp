# Replace __PRIVATE_TOKEN__ with the same random path used by the HTTPS proxy.
# Listen only on loopback; cloudflared connects here and provides public TLS.
server {
    listen 127.0.0.1:18800;
    server_name _;
    client_max_body_size 1m;

    location = /__PRIVATE_TOKEN__/mcp {
        access_log off;
        proxy_pass http://127.0.0.1:18791/mcp;
        proxy_http_version 1.1;
        proxy_set_header Host 127.0.0.1:18791;
        proxy_set_header Connection "";
        proxy_read_timeout 120s;
        proxy_buffering off;
    }

    location = /__PRIVATE_TOKEN__/ {
        access_log off;
        proxy_pass http://127.0.0.1:18791/mcp;
        proxy_http_version 1.1;
        proxy_set_header Host 127.0.0.1:18791;
        proxy_set_header Connection "";
        proxy_read_timeout 120s;
        proxy_buffering off;
    }

    location / { return 404; }
}
